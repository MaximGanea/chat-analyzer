# Copy to backend/.env and fill in values.
# backend/.env is git-ignored and must NEVER be committed.

ENVIRONMENT=development
APP_NAME=temple-project-api
APP_DEBUG=true

# Comma-separated origins for browser clients.
CORS_ALLOWED_ORIGINS=http://localhost:5173

# PostgreSQL (dev and prod parity).
DATABASE_URL=postgresql+asyncpg://temple_user:temple_pass@postgres:5432/temple_project?ssl=disable

# JWT settings.
JWT_SECRET_KEY=change-this-secret-in-production
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_MINUTES=15
JWT_REFRESH_TOKEN_DAYS=7
