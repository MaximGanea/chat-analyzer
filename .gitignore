# ============================================================
#  Root .gitignore
#  Catches OS / IDE / secrets that are project-agnostic.
#  App-specific rules live in backend/.gitignore and
#  frontend/.gitignore respectively.
# ============================================================

# --- Secrets & environment ---
.env
*.env
!**/.env.example

# --- OS ---
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# --- IDE / editors ---
.idea/
*.swp
*.swo
*~

# --- Docker overrides (local tweaks, never commit) ---
docker-compose.override.yml
